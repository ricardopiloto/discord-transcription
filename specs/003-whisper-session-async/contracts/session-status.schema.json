{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whisper-service/session-status.json",
  "title": "SessionStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "processed", "total", "started_at"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["in_progress", "done", "failed"]
    },
    "processed": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "utterances_com_texto": { "type": "integer", "minimum": 0 },
    "output_path": { "type": "string" },
    "error": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "done" } } },
      "then": {
        "required": ["utterances_com_texto", "output_path", "finished_at"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "required": ["error", "finished_at"]
      }
    }
  ]
}

# Discord — ver README seção "Configuração do bot Discord"
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Gravação
RECORDINGS_DIR=./recordings
UTTERANCE_SILENCE_MS=1000
AUTO_END_EMPTY_CHANNEL_MS=300000

# Webhook n8n (disparado ao encerrar sessão)
N8N_WEBHOOK_URL=

# Alertas DAVE mid-session → Telegram Bot API (opcional; sem token/chat_id o envio é omitido)
CRONISTA_TELEGRAM_BOT_TOKEN=
CRONISTA_TELEGRAM_CHAT_ID=
# CRONISTA_TELEGRAM_API_BASE=https://api.telegram.org

# Recuperação DAVE (defaults seguros para mesa longa)
CRONISTA_DAVE_FAILURE_THRESHOLD=5
CRONISTA_DAVE_FAILURE_WINDOW_S=10
CRONISTA_RECONNECT_MAX_ATTEMPTS=5
CRONISTA_RECONNECT_BACKOFF_S=3
CRONISTA_RECOVERY_COOLDOWN_S=60
CRONISTA_RECONNECT_VALIDATE_TIMEOUT_S=30

# Opcional: canal/guild para início automático (fase futura)
# AUTO_JOIN_GUILD_ID=
# AUTO_JOIN_CHANNEL_ID=
# AUTO_JOIN_GM_USER_ID=
